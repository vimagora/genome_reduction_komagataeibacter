# Pipeline configuration.
#
# Shared defaults. Keep your own paths in config/local.env (see the end of
# this file), so updating the repository never conflicts with them.
#
# Run every command from the repository root. Before running a Python script
# or an interactive step, load this file into your shell:
#
#   set -a; source config/config.env; set +a
#
# The bash and SLURM scripts load it themselves.

# --- Inputs ------------------------------------------------------------------
# One row per genome: sample name, NCBI assembly accession, taxonomy,
# BUSCO lineage, and include=yes/no for the phylogenomic and HGT analyses.
GENOMES=config/genomes.tsv
# Target genome, chromosome accession, and start/end of the region (1-based, inclusive).
REGION=config/region.tsv

# --- Locations ---------------------------------------------------------------
PROJECT_ROOT=/path/to/work_dir                  # every output is written under this directory
ENV_ROOT=/path/to/conda_envs                    # environments from envs/*.yaml, created as <name>-env
RANGER_DTL=/path/to/Ranger-DTL.linux            # RANGER-DTL binary
GTDBTK_DATA_PATH=/path/to/gtdbtk_db/release232  # GTDB-Tk reference data (release 232)
BUSCO_DOWNLOADS=/path/to/busco_downloads        # BUSCO lineage datasets (downloaded automatically if missing)
TAXONKIT_DB=/path/to/taxdump                    # NCBI taxonomy dump for taxonkit
BLASTP_DB=nr                                    # BLAST protein database with taxonomy files; CSC: /dataset/project_2020345/blast/nr

# --- Commands ----------------------------------------------------------------
# Command run before blastp to make it available. On CSC Roihu:
#   "module load bio-apps/v202603 && module load blast-plus"
BLAST_SETUP=""
SLURM_ACCOUNT=your_account

# --- Analysis settings -------------------------------------------------------
# Case-insensitive pattern: CDS products matching it count as transposases/IS.
IS_PATTERN='transpos|IS[0-9]|insertion sequence'
GTDBTK_OUTGROUP=p__Acidobacteriota
# Transfers whose donor belongs to the target's own taxon at this rank are not distant HGT.
DONOR_EXCLUDE_RANK=Family
# blastp: number of query chunks (one SLURM array task each), and taxa to search
# (NCBI taxids, comma-separated; 2 = Bacteria; empty = all of the database).
BLAST_CHUNKS=10
BLASTP_TAXIDS=2
OUTGROUP_TOP_N=20
N_PERMUTATIONS=10000
PERMUTATION_SEED=42
# Extra RANGER-DTL options, e.g. a fixed random seed if your build supports one.
RANGER_ARGS=""

# --- Local settings ----------------------------------------------------------
# Put your own paths and settings in config/local.env (not tracked by git); any
# variable set there overrides the value above.
if [[ -f config/local.env ]]; then
    source config/local.env
fi
